[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1HNAME[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8Husermod - modify a user account[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1HSYNOPSIS[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8Husermod [options] LOGIN[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1HDESCRIPTION[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8HThe usermod command modifies the system account files.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1HOPTIONS[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8HThe options which apply to the usermod command are:[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   Add the user to the supplementary group(s). Use only with the -G option.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   Allow names that do not conform to standards.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   update the comment field of the user in /etc/passwd, which is normally modified using the[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   chfn(1) utility.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   The user's new login directory.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   If the -m option is given, the contents of the current home directory will be moved to[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   the new home directory, which is created if it does not already exist. If the current[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   home directory does not exist the new home directory will not be created.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   The date on which the user account will be disabled. The date is specified in the format[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   YYYY-MM-DD. Integers as input are interpreted as days after 1970-01-01.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   An input of -1 or an empty string will blank the account expiration field in the shadow[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   password file. The account will remain available with no date limit.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   This option requires a /etc/shadow file. A /etc/shadow entry will be created if there[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   were none.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   defines the number of days after the password exceeded its maximum age during which the[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   user may still login by immediately replacing the password. This grace period before the[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   account becomes inactive is stored in the shadow password file. An input of 0 will[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   disable an expired password with no delay. An input of -1 will blank the respective field[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   in the shadow password file. See shadow(5) for more information.[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;1H[?25l[?12l[?25h7[2;54r8[54d
[1;56r[53;8H[38;5;208m[1K [39m(B[m   This option requires a /etc/shadow file. A /etc/shadow entry will be created if there[?25l[?12l[?25h7[2;54r8[54d
